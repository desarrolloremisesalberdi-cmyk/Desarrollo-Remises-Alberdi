{
  "expo": {
    "name": "Radio Taxis Alberdi - Chofer",
    "slug": "app-chofer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-alberdi.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.radiotaxisalberdi.chofer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBTsDYbXBONhz4OlA4dXEVvav16bkIQ2to"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#1e442c",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBTsDYbXBONhz4OlA4dXEVvav16bkIQ2to"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Radio Taxis Alberdi necesita tu ubicación para asignarte viajes y guiarte hasta el pasajero mientras conduces.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { *; }\n-keepclassmembers class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keepattributes *Annotation*,Signature,EnclosingMethod"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e442c",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1e442c"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "494776a1-6c9d-4a64-ab11-a73ef549f6d6"
      }
    },
    "owner": "desarrolloremisesalberdi"
  }
}
