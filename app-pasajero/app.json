{
  "expo": {
    "name": "Radio Taxis Alberdi - Pasajero",
    "slug": "app-pasajero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-alberdi.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.radiotaxisalberdi.pasajero",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBTsDYbXBONhz4OlA4dXEVvav16bkIQ2to"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#1e442c",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBTsDYbXBONhz4OlA4dXEVvav16bkIQ2to"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Radio Taxis Alberdi necesita acceder a tu ubicación para definir el punto de partida de tu viaje."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { *; }\n-keepclassmembers class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keepattributes *Annotation*,Signature,EnclosingMethod"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e442c",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1e442c"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "29797de7-11ca-410c-9ff3-c9eaab21154e"
      }
    },
    "owner": "desarrolloremisesalberdi"
  }
}
